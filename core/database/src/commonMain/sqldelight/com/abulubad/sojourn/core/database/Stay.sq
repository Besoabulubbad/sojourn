-- A listing and its children. The database is the source of truth (ADR 0007); a refresh replaces a stay's rows.
CREATE TABLE stay (
    id TEXT NOT NULL PRIMARY KEY,
    city_id TEXT NOT NULL,
    area_key TEXT NOT NULL,
    title_text TEXT NOT NULL,
    title_lang TEXT NOT NULL,
    description_text TEXT NOT NULL,
    description_lang TEXT NOT NULL,
    bedrooms INTEGER NOT NULL,
    beds INTEGER NOT NULL,
    bathrooms INTEGER NOT NULL,
    sleeps INTEGER NOT NULL,
    rating_score REAL,
    rating_count INTEGER,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    radius_metres INTEGER NOT NULL,
    from_minor INTEGER NOT NULL,
    from_currency TEXT NOT NULL,
    from_basis TEXT NOT NULL,
    from_excludes TEXT NOT NULL,
    walk_minutes INTEGER,
    long_stay_discount_percent INTEGER,
    -- 0 or 1.
    instant_book INTEGER NOT NULL
);

CREATE INDEX stay_city ON stay(city_id);

CREATE TABLE photo (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    id TEXT NOT NULL,
    url TEXT NOT NULL,
    caption_text TEXT,
    caption_lang TEXT,
    PRIMARY KEY (stay_id, position)
);

CREATE TABLE stay_amenity (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    amenity_id TEXT NOT NULL,
    PRIMARY KEY (stay_id, amenity_id)
);

-- One row per policy; the columns a kind needs are set, the rest are null. Every kind carries its number (N-03).
CREATE TABLE policy (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    kind TEXT NOT NULL,
    date TEXT,
    days INTEGER,
    amount_minor INTEGER,
    currency TEXT,
    refundable INTEGER, -- 0 or 1
    time TEXT,
    method TEXT,
    nights INTEGER,
    PRIMARY KEY (stay_id, position)
);

CREATE TABLE blocked_range (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    start_date TEXT NOT NULL,
    end_date TEXT NOT NULL,
    PRIMARY KEY (stay_id, start_date)
);

-- What the price includes (Details), by PriceInclusion id.
CREATE TABLE stay_inclusion (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    inclusion_id TEXT NOT NULL,
    PRIMARY KEY (stay_id, inclusion_id)
);

-- The server's translations of a stay's description, one per language; shown only when the guest asks (S-06).
CREATE TABLE description_translation (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    lang TEXT NOT NULL,
    text TEXT NOT NULL,
    PRIMARY KEY (stay_id, lang)
);

-- A stay's latest reviews, fetched with Details; position 0 is the newest. Month is ISO yyyy-MM.
CREATE TABLE review (
    stay_id TEXT NOT NULL REFERENCES stay(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    author TEXT NOT NULL,
    month TEXT NOT NULL,
    text TEXT NOT NULL,
    lang TEXT NOT NULL,
    PRIMARY KEY (stay_id, position)
);

-- A stay is written as insert-if-absent then update, never INSERT OR REPLACE: a replace deletes the row, and the
-- cascade would drop the children a list refresh does not carry (blocked dates, reviews).
insertStayIfAbsent:
INSERT OR IGNORE INTO stay VALUES ?;

updateStay:
UPDATE stay SET
    city_id = :city_id,
    area_key = :area_key,
    title_text = :title_text,
    title_lang = :title_lang,
    description_text = :description_text,
    description_lang = :description_lang,
    bedrooms = :bedrooms,
    beds = :beds,
    bathrooms = :bathrooms,
    sleeps = :sleeps,
    rating_score = :rating_score,
    rating_count = :rating_count,
    latitude = :latitude,
    longitude = :longitude,
    radius_metres = :radius_metres,
    from_minor = :from_minor,
    from_currency = :from_currency,
    from_basis = :from_basis,
    from_excludes = :from_excludes,
    walk_minutes = :walk_minutes,
    long_stay_discount_percent = :long_stay_discount_percent,
    instant_book = :instant_book
WHERE id = :id;

insertPhoto:
INSERT OR REPLACE INTO photo VALUES ?;

insertAmenity:
INSERT OR REPLACE INTO stay_amenity VALUES ?;

insertPolicy:
INSERT OR REPLACE INTO policy VALUES ?;

insertBlocked:
INSERT OR REPLACE INTO blocked_range VALUES ?;

insertInclusion:
INSERT OR REPLACE INTO stay_inclusion VALUES ?;

insertTranslation:
INSERT OR REPLACE INTO description_translation VALUES ?;

insertReview:
INSERT OR REPLACE INTO review VALUES ?;

-- The children a stay carries in every response. Blocked dates and reviews come only with the stay's own refresh,
-- which replaces them itself, so a list refresh never clears them.
clearChildren {
    DELETE FROM photo WHERE stay_id = :stayId;
    DELETE FROM stay_amenity WHERE stay_id = :stayId;
    DELETE FROM policy WHERE stay_id = :stayId;
    DELETE FROM stay_inclusion WHERE stay_id = :stayId;
    DELETE FROM description_translation WHERE stay_id = :stayId;
}

all:
SELECT * FROM stay ORDER BY id;

inCity:
SELECT * FROM stay WHERE city_id = ? ORDER BY id;

byId:
SELECT * FROM stay WHERE id = ?;

byIds:
SELECT * FROM stay WHERE id IN ? ORDER BY id;

photosFor:
SELECT * FROM photo WHERE stay_id IN ? ORDER BY stay_id, position;

amenitiesFor:
SELECT * FROM stay_amenity WHERE stay_id IN ? ORDER BY stay_id, amenity_id;

policiesFor:
SELECT * FROM policy WHERE stay_id = ? ORDER BY position;

blockedFor:
SELECT * FROM blocked_range WHERE stay_id = ? ORDER BY start_date;

count:
SELECT count(*) FROM stay;

idsInCity:
SELECT id FROM stay WHERE city_id = ?;

allIds:
SELECT id FROM stay;

deleteById:
DELETE FROM stay WHERE id = ?;

policiesIn:
SELECT * FROM policy WHERE stay_id IN ? ORDER BY stay_id, position;

clearBlocked:
DELETE FROM blocked_range WHERE stay_id = ?;

inclusionsFor:
SELECT * FROM stay_inclusion WHERE stay_id IN ? ORDER BY stay_id, inclusion_id;

translationsFor:
SELECT * FROM description_translation WHERE stay_id IN ? ORDER BY stay_id, lang;

reviewsFor:
SELECT * FROM review WHERE stay_id = ? ORDER BY position;

clearReviews:
DELETE FROM review WHERE stay_id = ?;
