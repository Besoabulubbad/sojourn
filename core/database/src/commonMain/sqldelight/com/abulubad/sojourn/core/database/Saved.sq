-- Stays the guest saved. Saved state is local: it survives offline and is never lost on a refresh.
CREATE TABLE saved (
    stay_id TEXT NOT NULL PRIMARY KEY,
    saved_at INTEGER NOT NULL
);

save:
INSERT OR REPLACE INTO saved VALUES (?, ?);

remove:
DELETE FROM saved WHERE stay_id = ?;

all:
SELECT * FROM saved ORDER BY saved_at DESC;

isSaved:
SELECT count(*) > 0 FROM saved WHERE stay_id = ?;
