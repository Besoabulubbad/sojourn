<?xml version="1.0" encoding="utf-8"?>
<!--
  British English (the default locale). Every key here must also exist in values-ar/strings.xml: the
  verifyPlurals task fails the build otherwise (S-03, S-05). Keys follow the glossary in docs/design-system/brand-book.md:
  one term per concept. Sentence case; buttons are verb + object; no exclamation marks.
-->
<resources>
    <!-- App -->
    <string name="app_name">Sojourn</string>
    <string name="app_tagline">Furnished homes for a few nights to a year</string>

    <!-- Languages are named in their own script, never with flags (L-06). Same value in every locale. -->
    <string name="language_en">English</string>
    <string name="language_ar">العربية</string>

    <!-- Tabs -->
    <string name="tab_explore">Explore</string>
    <string name="tab_saved">Saved</string>
    <string name="tab_bookings">Bookings</string>
    <string name="tab_profile">Profile</string>

    <!-- Actions (verb + object) -->
    <string name="action_back">Back</string>
    <string name="action_close">Close</string>
    <string name="action_search">Search</string>
    <string name="action_reserve">Reserve</string>
    <string name="action_share">Share</string>
    <string name="action_save">Save</string>
    <string name="action_unsave">Remove from saved</string>
    <string name="action_retry">Try again</string>
    <string name="action_translate">Translate</string>
    <string name="action_show_original">Show original</string>
    <string name="action_choose_dates">Choose dates</string>
    <string name="action_clear_filters">Clear filters</string>
    <string name="action_show_stays">Show %1$s</string>
    <string name="action_pay">Pay %1$s</string>
    <string name="action_open_in_maps">Open in maps</string>

    <!-- Screen states (I-05) -->
    <string name="state_loading">Loading</string>
    <string name="state_empty_title">Nothing here yet</string>
    <string name="state_empty_body">Change your dates or filters to see more stays.</string>
    <string name="state_error_title">Something went wrong</string>
    <string name="state_error_body">Check your connection and try again.</string>
    <string name="state_offline_title">You are offline</string>
    <string name="state_offline_body">Showing stays saved on this device.</string>

    <!-- Appearance -->
    <string name="theme_system">System</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>

    <!-- Prices (every amount is pre-formatted by SojournFormatter, P-06) -->
    <string name="price_total">%1$s total</string>
    <string name="price_from_night">from %1$s a night</string>
    <string name="price_from_month">from %1$s a month</string>
    <!-- Price card: the nightly figure under a total is always all-in; a raw nightly rate is never shown. -->
    <string name="price_nightly_all_in">%1$s a night, all fees included</string>
    <string name="price_before_fees">Before %1$s. Add dates for the exact total.</string>
    <string name="price_long_stay">Long-stay price</string>
    <string name="price_long_stay_saving">%1$s on stays of %2$s or more</string>
    <string name="exclusion_utilities">utilities</string>
    <string name="exclusion_cleaning_fee">cleaning fee</string>
    <string name="exclusion_deposit">deposit</string>
    <string name="exclusion_city_tax">city tax</string>
    <string name="line_nights">%1$s × %2$s</string>
    <string name="line_long_stay_discount">Long-stay discount</string>
    <string name="line_cleaning_fee">Cleaning fee</string>
    <string name="line_service_fee">Service fee</string>
    <string name="line_city_tax">City tax</string>
    <string name="line_deposit">Refundable deposit</string>
    <string name="line_total">Total</string>

    <!-- Facts (N-01: a studio is "Studio", never "0 bedrooms") -->
    <string name="facts_studio">Studio</string>
    <string name="facts_sleeps">Sleeps %1$s</string>
    <string name="facts_separator"> · </string>
    <string name="transit_walk">%1$s to %2$s</string>

