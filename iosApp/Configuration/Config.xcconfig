TEAM_ID=

PRODUCT_NAME=Sojourn
PRODUCT_BUNDLE_IDENTIFIER=com.abulubad.sojourn.Sojourn$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
// The Shared framework is static, so its link flags do not reach this target. SQLDelight's native driver
// (core:database) needs the system SQLite, as SQLDelight's docs say for static frameworks.
OTHER_LDFLAGS = $(inherited) -lsqlite3
